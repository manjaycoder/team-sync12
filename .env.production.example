# Team-Sync Production Environment Variables (Render Single-Instance)
NODE_ENV=production
PORT=10000

# MongoDB Connection String (e.g., MongoDB Atlas Cloud M0 Cluster)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/team-sync?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin:your_secure_password@cluster0.abcde.mongodb.net/team-sync?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a strong 32+ char secret or let Render generate it)
JWT_SECRET=teamsync_jwt_production_secure_secret_random_token_string

# Token Expiration Duration
JWT_EXPIRES_IN=7d

# Auto-seed initial demo departments, users, projects, and tasks on first startup if DB is empty
AUTO_SEED=true

# Google Gemini API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyYourGoogleGeminiApiKeyHere

# Optional: Frontend URL (Only needed if deploying frontend separately; for single instance, same-origin is automatic)
FRONTEND_URL=https://team-sync.onrender.com
