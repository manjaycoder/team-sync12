# Server Environment Variables
PORT=5001
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/team-sync

# JWT Authentication Secret
JWT_SECRET=teamsync_jwt_super_secret_key_2026_production_ready
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key
# Provide your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional local test account. Provision with `npm run create:test-account`.
# Never configure these values in production.
TEST_ACCOUNT_EMAIL=tester@team-sync.local
TEST_ACCOUNT_PASSWORD=choose-a-local-password-with-12-or-more-characters